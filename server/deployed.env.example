# Copy to server/.env on the production host. Do not put real passwords in git.
# The live admin CORS error is not caused by missing FRONTEND_URL — the API
# already returns Access-Control-Allow-Origin for https://www.elevatehub.co.ke.
# A 500 on /api/stock/products is a server crash, not a CORS block.

# MongoDB — include the database name after the host
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/elevate

PORT=5010
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret

FRONTEND_URL=https://www.elevatehub.co.ke
API_URL=https://backend.codewithseth.co.ke
ALLOW_ALL_ORIGINS=true

EMAIL_HOST=mail.elevatehub.co.ke
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=system@elevatehub.co.ke
EMAIL_PASSWORD=
EMAIL_FROM=system@elevatehub.co.ke

SMTP_HOST=mail.elevatehub.co.ke
SMTP_PORT=587
SMTP_USER=system@elevatehub.co.ke
SMTP_PASS=
SMTP_FROM=system@elevatehub.co.ke
SYSTEM_FROM_NAME=ElevateHub

MYSQL_HOST=localhost
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=elevat10_datalake
MYSQL_DATABASE_URL=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_BASE_URL=https://api.africastalking.com/version1/messaging
DISPATCH_DEFAULT_COUNTRY_CODE=254
DISPATCH_OFFICE_NUMBER=

WEBSMS_CLIENT_ID=
WEBSMS_ACTOR_ID=
WEBSMS_API_KEY=
WEBSMS_SENDER_ID=

APP_NAME=ELEVATE

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_HTTP_REFERER=https://www.elevatehub.co.ke
OPENROUTER_APP_NAME=Elevate HR
OPENROUTER_MAX_TOKENS=1500

COMPANY_DELETE_OTP_EMAIL=info@elevatehub.co.ke

CFT_IP_SESSION=
CFT_INGEST_ENABLED=false
CFT_INGEST_INTERVAL_MS=900000
CFT_INGEST_RUN_ON_BOOT=false
CFT_RAW_DB=cft_raw
CFT_TARGET_ORG_ID=
CFT_TARGET_EMAIL=
