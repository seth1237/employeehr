# Database Configuration
MONGODB_URI=

# MySQL secondary storage (MongoDB sync cache)
# Local (with docker-compose.mysql.yml): mysql://elevate:elevate123@localhost:3306/elevate_dev
MYSQL_DATABASE_URL=

# Optional: disable automatic Mongo→MySQL sync interval (ms). Default 300000 (5 min)
# AUTO_SYNC_INTERVAL_MS=300000

# AI Assistant (MongoDB + LangChain + OpenRouter)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Keep max tokens modest so low-credit accounts can still call the model
OPENROUTER_MAX_TOKENS=1500
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Elevate HR
# Fallback if you prefer OpenAI directly instead of OpenRouter:
# OPENAI_API_KEY=

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=

# Credential encryption for tenant SMTP passwords (32+ chars recommended; falls back to JWT_SECRET)
ENCRYPTION_KEY=

# Platform owner access (comma-separated emails, or use super_admin role)
PLATFORM_OWNER_EMAILS=bellarinseth@gmail.com

# OTP destination for permanent company deletion (owner console)
COMPANY_DELETE_OTP_EMAIL=info@elevatehub.co.ke

# Fleet / vehicle tracker
# Shared secret for GPS device webhook POST /api/vehicles/ingest (optional but recommended)
FLEET_INGEST_TOKEN=
# Speed (km/h) above which overspeed alerts are created
FLEET_OVERSPEED_KMH=100

# ---------------------------------------------------------------------------
# CFT website ingest (embedded streamer → cft_raw → Accord ERP tenant)
# When CFT_IP_SESSION is set, the API process runs the streamer on a schedule.
# No separate systemd streamer deploy is required.
# ---------------------------------------------------------------------------
CFT_IP_SESSION=
# CFT_INGEST_ENABLED=true
# CFT_INGEST_INTERVAL_MS=900000
# CFT_INGEST_RUN_ON_BOOT=true
# CFT_BASE_URL=https://cloud.cft.co.ke
# CFT_RAW_DB=cft_raw
# CFT_MONGODB_URI=   # defaults to MONGODB_URI (same cluster, different DB name)
# CFT_TARGET_ORG_ID=6a44f74def187ec13c55c90f
# CFT_TARGET_EMAIL=accordmedsupplies@gmail.com
# CFT_SLEEP_MS=300

# Frontend URL (for links / emails)
FRONTEND_URL=http://localhost:3000

# Login OTP (on by default for non-local / deployed). Local dev always skips.
# OTP_REQUIRED_DOMAINS=elevatehub.co.ke,www.elevatehub.co.ke,hr.codewithseth.co.ke
# SKIP_LOGIN_OTP=true
# LOGIN_OTP_STRICT=false  # allow password-only login if OTP email fails (not recommended in prod)

# CORS is open to all origins in server/src/index.ts (origin: true)

# Email Configuration (optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@elevate.com

# WebSMS Provider Configuration (Dispatch SMS)
WEBSMS_CLIENT_ID=
WEBSMS_API_KEY=
WEBSMS_ENDPOINT=https://sms.websms.co.ke/v1/onfonapps/sms:sendCampaign
WEBSMS_DEFAULT_SENDER_NAME=YourCompany

# Dispatch SMS defaults
DISPATCH_DEFAULT_COUNTRY_CODE=254
DISPATCH_OFFICE_NUMBER=

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-api-domain/api/mpesa/callback
MPESA_CALLBACK_TOKEN=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_DEFAULT_COUNTRY_CODE=254
