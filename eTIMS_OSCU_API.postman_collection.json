  "item": [
    {
      "name": "1. Core System Setup & Initialization",
      "item": [
        {
          "name": "OSCU Initialization",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "tin", "value": "{{tin}}"},
              {"key": "bhfId", "value": "{{bhfId}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tin\": \"{{tin}}\",\n  \"bhfId\": \"{{bhfId}}\",\n  \"dvcSrlNo\": \"ELEVATEHUB-AMS-001\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/selectInitOsdcInfo",
              "host": ["{{baseUrl}}"],
              "path": ["selectInitOsdcInfo"]
            },
            "description": "Registers the device and retrieves the primary communication key (cmcKey). NOTE: This is the only call that does NOT require the cmcKey header, since it is used to obtain it. Copy the returned cmcKey into the {{cmcKey}} collection variable afterward."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Auto-save cmcKey from response into the environment for subsequent requests",
                  "try {",
                  "    const jsonData = pm.response.json();",
                  "    const cmcKey = jsonData?.data?.info?.cmcKey || jsonData?.data?.cmcKey;",
                  "    if (cmcKey) {",
                  "        pm.collectionVariables.set('cmcKey', cmcKey);",
                  "        console.log('Saved cmcKey:', cmcKey);",
                  "    }",
                  "} catch (e) {",
                  "    console.log('Could not auto-extract cmcKey, please set it manually.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
